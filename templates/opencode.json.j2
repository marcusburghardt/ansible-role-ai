{
    "$schema": "https://opencode.ai/config.json",
    "model": {{ ai_model | to_json }},
    "update": "notify",
    "plugins": {{ ai_opencode_plugins | to_json }},
    "agents": {{ ai_opencode_agents | to_json }},
    "providers": {{ ai_opencode_providers | to_json }},
    "permissions": {{ _ai_opencode_permissions_merged | to_nice_json(indent=6) }},
    "compaction": {{ ai_opencode_compaction | to_json }},
    "instructions": {{ ai_opencode_instructions | to_json }},
    "watcher": {
      "ignore": ["node_modules/**", "dist/**", ".git/**", "vendor/**"]
    }
}
