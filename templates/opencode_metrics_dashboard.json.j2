{% set budget = ai_grafana_metrics_monthly_budget %}
{% set daily_warn = (budget / 30) | round(2) %}
{% set daily_crit = (budget / 15) | round(2) %}
{% set weekly_warn = (budget * 7 / 30) | round(2) %}
{% set weekly_crit = (budget * 14 / 30) | round(2) %}
{% set monthly_warn = budget | round(2) %}
{% set monthly_crit = (budget * 2) | round(2) %}
{% set yearly_warn = (budget * 12) | round(2) %}
{% set yearly_crit = (budget * 24) | round(2) %}
{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "id": 100, "title": "Key Metrics", "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false, "panels": []
    },
    {
      "id": 7, "title": "Today's Cost", "type": "stat", "transparent": true,
      "description": "Actual cost incurred today (UTC), computed from incremental deltas. Accurately splits multi-day session costs by day. Budget pace: ${{ '%.0f' | format(daily_warn) }}/day (monthly ${{ '%.0f' | format(budget) }}).",
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 1 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "opencode-metrics-sqlite" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "#73BF69", "value": null }, { "color": "#FADE2A", "value": {{ daily_warn }} }, { "color": "#F2495C", "value": {{ daily_crit }} }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [{ "rawQueryText": "SELECT ROUND(COALESCE(SUM(delta), 0), 2) as \"Today's Cost\" FROM v_measurement_deltas WHERE metric_name = 'cost' AND date(recorded_at_epoch, 'unixepoch') = date('now')", "queryType": "table", "refId": "A" }]
    },
    {
      "id": 8, "title": "Active This Week", "type": "stat", "transparent": true,
      "description": "Cumulative cost of sessions active since Monday (UTC). Includes the full cost of reused sessions. Budget pace: ${{ '%.0f' | format(weekly_warn) }}/week.",
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 1 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "opencode-metrics-sqlite" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "#73BF69", "value": null }, { "color": "#FADE2A", "value": {{ weekly_warn }} }, { "color": "#F2495C", "value": {{ weekly_crit }} }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [{ "rawQueryText": "SELECT ROUND(COALESCE(SUM(value), 0), 2) as \"Active This Week\" FROM v_measurements WHERE metric_name = 'cost' AND recorded_at_epoch >= CAST(strftime('%s', date('now', 'weekday 1', '-7 days')) AS INTEGER)", "queryType": "table", "refId": "A" }]
    },
    {
      "id": 9, "title": "Active This Month", "type": "stat", "transparent": true,
      "description": "Cumulative cost of sessions active since the 1st of this month (UTC). Includes the full cost of reused sessions. Budget: ${{ '%.0f' | format(budget) }}/month.",
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 1 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "opencode-metrics-sqlite" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "#73BF69", "value": null }, { "color": "#FADE2A", "value": {{ monthly_warn }} }, { "color": "#F2495C", "value": {{ monthly_crit }} }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [{ "rawQueryText": "SELECT ROUND(COALESCE(SUM(value), 0), 2) as \"Active This Month\" FROM v_measurements WHERE metric_name = 'cost' AND recorded_at_epoch >= CAST(strftime('%s', date('now', 'start of month')) AS INTEGER)", "queryType": "table", "refId": "A" }]
    },
    {
      "id": 10000, "title": "Active This Year", "type": "stat", "transparent": true,
      "description": "Cumulative cost of sessions active since January 1st (UTC). Includes the full cost of reused sessions. Budget pace: ${{ '%.0f' | format(yearly_warn) }}/year.",
      "gridPos": { "h": 4, "w": 5, "x": 15, "y": 1 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "opencode-metrics-sqlite" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "#73BF69", "value": null }, { "color": "#FADE2A", "value": {{ yearly_warn }} }, { "color": "#F2495C", "value": {{ yearly_crit }} }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [{ "rawQueryText": "SELECT ROUND(COALESCE(SUM(value), 0), 2) as \"Active This Year\" FROM v_measurements WHERE metric_name = 'cost' AND recorded_at_epoch >= CAST(strftime('%s', date('now', 'start of year')) AS INTEGER)", "queryType": "table", "refId": "A" }]
    },
    {
      "id": 2, "title": "Total Cost", "type": "stat", "transparent": true,
      "description": "All-time cumulative cost across all sessions.",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "opencode-metrics-sqlite" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "color": { "mode": "fixed", "fixedColor": "#73BF69" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "#73BF69", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [{ "rawQueryText": "SELECT ROUND(SUM(value), 2) as \"Total Cost\" FROM v_measurements WHERE metric_name = 'cost'", "queryType": "table", "refId": "A" }]
    },
    {
      "id": 1, "title": "Total Sessions", "type": "stat", "transparent": true,
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 5 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "opencode-metrics-sqlite" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#B877D9" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "#B877D9", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [{ "rawQueryText": "SELECT COUNT(*) as \"Total Sessions\" FROM sessions", "queryType": "table", "refId": "A" }]
    },
    {
      "id": 3, "title": "Avg Session Cost", "type": "stat", "transparent": true,
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 5 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "opencode-metrics-sqlite" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "#73BF69", "value": null }, { "color": "#FADE2A", "value": {{ (daily_warn / 3) | round(2) }} }, { "color": "#F2495C", "value": {{ daily_warn | round(2) }} }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [{ "rawQueryText": "SELECT ROUND(AVG(value), 4) as \"Avg Cost\" FROM v_measurements WHERE metric_name = 'cost'", "queryType": "table", "refId": "A" }]
    },
    {
      "id": 4, "title": "Cache Hit %", "type": "stat", "transparent": true,
      "description": "Fraction of input tokens served from prompt cache. Higher is better -- cached tokens cost less.",
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 5 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "opencode-metrics-sqlite" },
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "#F2495C", "value": null }, { "color": "#FADE2A", "value": 30 }, { "color": "#73BF69", "value": 60 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [{ "rawQueryText": "SELECT ROUND(AVG(value) * 100, 1) as \"Cache Hit\" FROM v_measurements WHERE metric_name = 'cache_hit_ratio'", "queryType": "table", "refId": "A" }]
    },
    {
      "id": 5, "title": "Output Tokens (M)", "type": "stat", "transparent": true,
      "description": "Total output tokens generated across all sessions, in millions.",
      "gridPos": { "h": 4, "w": 5, "x": 15, "y": 5 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "opencode-metrics-sqlite" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#5794F2" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "#5794F2", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [{ "rawQueryText": "SELECT ROUND(SUM(value) / 1000000, 1) as \"Output Tokens (M)\" FROM v_measurements WHERE metric_name = 'tokens_output'", "queryType": "table", "refId": "A" }]
    },
    {
      "id": 6, "title": "Active Projects", "type": "stat", "transparent": true,
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 5 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "opencode-metrics-sqlite" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#36A2EB" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "#36A2EB", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [{ "rawQueryText": "SELECT COUNT(DISTINCT project_id) as \"Projects\" FROM sessions", "queryType": "table", "refId": "A" }]
    },

    {
      "id": 101, "title": "Cost Overview", "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": true,
      "panels": [
        {
          "id": 10, "title": "Daily Cost", "type": "timeseries", "transparent": true,
          "description": "Actual cost incurred per day, computed from incremental deltas. Accurately splits multi-day session costs. Spikes indicate expensive sessions -- expand Top Sessions to investigate. Historical data before the delta feature was deployed may appear empty.",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
          "datasource": { "type": "frser-sqlite-datasource", "uid": "opencode-metrics-sqlite" },
          "fieldConfig": { "defaults": { "unit": "currencyUSD", "color": { "mode": "fixed", "fixedColor": "#73BF69" }, "custom": { "drawStyle": "bars", "fillOpacity": 40, "gradientMode": "scheme", "pointSize": 5, "lineWidth": 1 } }, "overrides": [] },
          "options": { "tooltip": { "mode": "single" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "last"] } },
          "targets": [{ "rawQueryText": "SELECT MIN(recorded_at_epoch) as time, SUM(delta) as cost FROM v_measurement_deltas WHERE metric_name = 'cost' AND recorded_at_epoch >= $__from/1000 AND recorded_at_epoch <= $__to/1000 GROUP BY date(recorded_at_epoch, 'unixepoch') ORDER BY time", "queryType": "table", "timeColumns": ["time"], "refId": "A" }]
        },
        {
          "id": 11, "title": "Cost by Classification", "type": "piechart", "transparent": true,
          "description": "Cost breakdown by session type. Helps identify which types of work drive the most spending.",
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
          "datasource": { "type": "frser-sqlite-datasource", "uid": "opencode-metrics-sqlite" },
          "fieldConfig": { "defaults": { "unit": "currencyUSD", "color": { "mode": "palette-classic" } }, "overrides": [] },
          "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }, "tooltip": { "mode": "single" }, "pieType": "donut", "displayLabels": ["name", "value"], "reduceOptions": { "values": true, "calcs": [] } },
          "targets": [{ "rawQueryText": "SELECT s.classification, SUM(m.value) as cost FROM v_measurements m JOIN sessions s ON m.session_id = s.session_id WHERE m.metric_name = 'cost' GROUP BY s.classification ORDER BY cost DESC", "queryType": "table", "refId": "A" }]
        },
        {
          "id": 12, "title": "Cost by Model", "type": "barchart", "transparent": true,
          "description": "Total cost per model. Models marked 'unknown' indicate sessions where the model was not detected by the metrics plugin.",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
          "datasource": { "type": "frser-sqlite-datasource", "uid": "opencode-metrics-sqlite" },
          "fieldConfig": { "defaults": { "unit": "currencyUSD", "color": { "mode": "fixed", "fixedColor": "#73BF69" }, "custom": { "fillOpacity": 80, "gradientMode": "scheme" } }, "overrides": [] },
          "options": { "orientation": "horizontal", "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
          "targets": [{ "rawQueryText": "SELECT s.model, SUM(m.value) as cost FROM v_measurements m JOIN sessions s ON m.session_id = s.session_id WHERE m.metric_name = 'cost' GROUP BY s.model ORDER BY cost DESC", "queryType": "table", "refId": "A" }]
        },
        {
          "id": 13, "title": "Cost by Project (Top 10)", "type": "barchart", "transparent": true,
          "description": "Top 10 projects by total API cost. Edit this panel and adjust the LIMIT in the query to see more projects.",
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
          "datasource": { "type": "frser-sqlite-datasource", "uid": "opencode-metrics-sqlite" },
          "fieldConfig": { "defaults": { "unit": "currencyUSD", "color": { "mode": "fixed", "fixedColor": "#73BF69" }, "custom": { "fillOpacity": 80, "gradientMode": "scheme" } }, "overrides": [] },
          "options": { "orientation": "horizontal", "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
          "targets": [{ "rawQueryText": "SELECT p.name as project, SUM(m.value) as cost FROM v_measurements m JOIN sessions s ON m.session_id = s.session_id JOIN projects p ON s.project_id = p.project_id WHERE m.metric_name = 'cost' AND p.name != '' GROUP BY p.name ORDER BY cost DESC LIMIT 10", "queryType": "table", "refId": "A" }]
        },
        {
          "id": 14, "title": "Avg Cost per Session by Classification", "type": "barchart", "transparent": true,
          "description": "Average cost of a single session for each classification. Helps set expectations for how much each type of work typically costs.",
          "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
          "datasource": { "type": "frser-sqlite-datasource", "uid": "opencode-metrics-sqlite" },
          "fieldConfig": { "defaults": { "unit": "currencyUSD", "color": { "mode": "fixed", "fixedColor": "#FADE2A" }, "custom": { "fillOpacity": 80, "gradientMode": "scheme" } }, "overrides": [] },
          "options": { "orientation": "horizontal", "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
          "targets": [{ "rawQueryText": "SELECT s.classification, AVG(m.value) as avg_cost FROM v_measurements m JOIN sessions s ON m.session_id = s.session_id WHERE m.metric_name = 'cost' GROUP BY s.classification ORDER BY avg_cost DESC", "queryType": "table", "refId": "A" }]
        }
      ]
    },

    {
      "id": 102, "title": "Token Efficiency", "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "collapsed": true,
      "panels": [
        {
          "id": 20, "title": "Token Usage Over Time", "type": "timeseries", "transparent": true,
          "description": "Daily token consumption by type. Input = prompt context, Output = generated responses, Cache Read = tokens served from prompt cache. Cache read often dominates the scale -- click series names in the legend to toggle visibility.",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
          "datasource": { "type": "frser-sqlite-datasource", "uid": "opencode-metrics-sqlite" },
          "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 20, "pointSize": 5, "lineWidth": 2, "lineInterpolation": "smooth" } }, "overrides": [{ "matcher": { "id": "byName", "options": "tokens_input" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#5794F2" } }] }, { "matcher": { "id": "byName", "options": "tokens_output" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#73BF69" } }] }, { "matcher": { "id": "byName", "options": "tokens_cache_read" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#B877D9" } }] }] },
          "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "mean", "max"] } },
          "targets": [{ "rawQueryText": "SELECT MIN(recorded_at_epoch) as time, metric_name, SUM(value) as tokens FROM v_measurements WHERE metric_name IN ('tokens_input', 'tokens_output', 'tokens_cache_read') AND recorded_at_epoch >= $__from/1000 AND recorded_at_epoch <= $__to/1000 GROUP BY date(recorded_at_epoch, 'unixepoch'), metric_name ORDER BY time", "queryType": "table", "timeColumns": ["time"], "refId": "A" }]
        },
        {
          "id": 21, "title": "Token Distribution by Type", "type": "barchart", "transparent": true,
          "description": "Total tokens by type across all sessions. A high cache_read value indicates good prompt cache utilization. Bar chart used instead of pie because the scale difference between token types can be extreme.",
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
          "datasource": { "type": "frser-sqlite-datasource", "uid": "opencode-metrics-sqlite" },
          "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "#5794F2" }, "custom": { "fillOpacity": 80 } }, "overrides": [] },
          "options": { "orientation": "horizontal", "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
          "targets": [{ "rawQueryText": "SELECT metric_name as token_type, SUM(value) as total FROM v_measurements WHERE metric_name IN ('tokens_input', 'tokens_output', 'tokens_reasoning', 'tokens_cache_read', 'tokens_cache_write') GROUP BY metric_name ORDER BY total DESC", "queryType": "table", "refId": "A" }]
        },
        {
          "id": 22, "title": "Cache Hit Ratio Over Time", "type": "timeseries", "transparent": true,
          "description": "Fraction of input tokens served from prompt cache. Higher is better -- cached tokens cost less. Drops may indicate new projects or changed prompts that invalidate the cache.",
          "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
          "datasource": { "type": "frser-sqlite-datasource", "uid": "opencode-metrics-sqlite" },
          "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "color": { "mode": "fixed", "fixedColor": "#5794F2" }, "custom": { "drawStyle": "line", "fillOpacity": 20, "gradientMode": "scheme", "pointSize": 5, "lineWidth": 2 } }, "overrides": [] },
          "options": { "tooltip": { "mode": "single" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "mean", "max"] } },
          "targets": [{ "rawQueryText": "SELECT MIN(recorded_at_epoch) as time, AVG(value) as cache_hit_ratio FROM v_measurements WHERE metric_name = 'cache_hit_ratio' AND recorded_at_epoch >= $__from/1000 AND recorded_at_epoch <= $__to/1000 GROUP BY date(recorded_at_epoch, 'unixepoch') ORDER BY time", "queryType": "table", "timeColumns": ["time"], "refId": "A" }]
        }
      ]
    },

    {
      "id": 103, "title": "Session Analytics", "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "collapsed": true,
      "panels": [
        {
          "id": 30, "title": "Sessions by Day", "type": "timeseries", "transparent": true,
          "description": "Number of sessions per day. Tracks overall AI tool usage intensity.",
          "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
          "datasource": { "type": "frser-sqlite-datasource", "uid": "opencode-metrics-sqlite" },
          "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#B877D9" }, "custom": { "drawStyle": "bars", "fillOpacity": 50, "gradientMode": "scheme" } }, "overrides": [] },
          "options": { "tooltip": { "mode": "single" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "mean", "max"] } },
          "targets": [{ "rawQueryText": "SELECT MIN(started_at_epoch) as time, COUNT(*) as sessions FROM v_sessions WHERE started_at_epoch >= $__from/1000 AND started_at_epoch <= $__to/1000 GROUP BY date(started_at_epoch, 'unixepoch') ORDER BY time", "queryType": "table", "timeColumns": ["time"], "refId": "A" }]
        },
        {
          "id": 31, "title": "Sessions by Classification Over Time", "type": "timeseries", "transparent": true,
          "description": "Daily session breakdown by classification. Shows how your work type mix evolves -- widening bands indicate growing reliance on that classification.",
          "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
          "datasource": { "type": "frser-sqlite-datasource", "uid": "opencode-metrics-sqlite" },
          "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } }, "overrides": [] },
          "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] } },
          "targets": [{ "rawQueryText": "SELECT MIN(started_at_epoch) as time, classification, COUNT(*) as count FROM v_sessions WHERE started_at_epoch >= $__from/1000 AND started_at_epoch <= $__to/1000 GROUP BY date(started_at_epoch, 'unixepoch'), classification ORDER BY time", "queryType": "table", "timeColumns": ["time"], "refId": "A" }]
        },
        {
          "id": 32, "title": "Duration Distribution", "type": "barchart", "transparent": true,
          "description": "Session length distribution. Most sessions should be short; long sessions may indicate complex or stuck tasks.",
          "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
          "datasource": { "type": "frser-sqlite-datasource", "uid": "opencode-metrics-sqlite" },
          "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#B877D9" }, "custom": { "fillOpacity": 80, "gradientMode": "scheme" } }, "overrides": [] },
          "options": { "orientation": "vertical", "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
          "targets": [{ "rawQueryText": "SELECT CASE WHEN value < 60 THEN '< 1 min' WHEN value < 300 THEN '1-5 min' WHEN value < 900 THEN '5-15 min' WHEN value < 1800 THEN '15-30 min' WHEN value < 3600 THEN '30-60 min' ELSE '> 60 min' END as duration_bucket, COUNT(*) as count FROM v_measurements WHERE metric_name = 'duration_seconds' GROUP BY duration_bucket ORDER BY MIN(value)", "queryType": "table", "refId": "A" }]
        },
        {
          "id": 33, "title": "Sessions by Agent Type", "type": "piechart", "transparent": true,
          "description": "Distribution of sessions by agent (e.g. OpenCode, Cursor, Claude CLI). Shows which tools are being used most.",
          "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
          "datasource": { "type": "frser-sqlite-datasource", "uid": "opencode-metrics-sqlite" },
          "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } }, "overrides": [] },
