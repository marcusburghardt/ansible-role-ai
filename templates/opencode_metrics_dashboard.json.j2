          "targets": [{ "rawQueryText": "SELECT s.classification, AVG(m.value) as avg_cache_ratio, COUNT(*) as sessions FROM v_measurements m JOIN sessions s ON m.session_id = s.session_id WHERE m.metric_name = 'cache_hit_ratio' GROUP BY s.classification ORDER BY avg_cache_ratio DESC", "queryType": "table", "refId": "A" }]
        },
        {
          "id": 42, "title": "Cost per File Changed", "type": "stat", "transparent": true,
